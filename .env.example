# AI provider: gemini | anthropic | openai | none
LLM_PROVIDER=none

# API key for the chosen provider
LLM_API_KEY=your_key_here

# Model name (do not hardcode elsewhere; always read this var)
LLM_MODEL=gemini-2.0-flash

# Max LLM calls per day (cost guard)
LLM_DAILY_CALL_LIMIT=100


# Sign-in
# First admin, created on an empty database
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 1 = create demo accounts admin, lead, dev, pm (password below)
DEMO_ACCOUNTS=0
DEMO_PASSWORD=backstop-demo
# 1 = session cookie over HTTPS only (leave unset locally)
COOKIE_SECURE=
SESSION_HOURS=12
